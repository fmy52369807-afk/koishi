# Mirrors used by Koishi marketplace and assets.
GITHUB_MIRROR=
GITHUB_CONTENT_MIRROR=
GRAVATAR_MIRROR=

# Koishi runtime.
NODE_ENV=production
KOISHI_HOST=127.0.0.1
KOISHI_CONSOLE_OPEN=false
KOISHI_ONEBOT_SELF_ID=
KOISHI_AGENT=
KOISHI_WEATHER_CITY=Wuhan

# Optional Coze integration.
COZE_BOT_ID=
COZE_TOKEN=

# DeepSeek chat model.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000
CHATLUNA_MODEL=DeepSeek/deepseek-v4-flash

# SiliconFlow embedding, ASR, image fallback, and optional vision.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_TIMEOUT_MS=45000

# OpenAI-compatible image generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
IMAGE_GENERATION_TIMEOUT_MS=90000
IMAGE_DOWNLOAD_TIMEOUT_MS=30000

# Vision model. Defaults can use SiliconFlow Qwen-VL with SILICONFLOW_API_KEY.
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_MAX_IMAGES=2
VISION_TIMEOUT_MS=45000
VISION_IMAGE_FETCH_TIMEOUT_MS=12000
VISION_INLINE_REMOTE_IMAGES=false

# Tavily web search.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_TIMEOUT_MS=20000
TAVILY_CACHE_TTL_MS=7200000
TAVILY_COOLDOWN_MS=30000
TAVILY_MAX_RESULTS=5

# Custom TTS service.
TTS_API_URL=
TTS_REF_AUDIO_PATH=
TTS_PROMPT_TEXT=
TTS_PROMPT_LANG=zh
TTS_TEXT_LANG=zh
TTS_TIMEOUT_MS=60000

# Shared HTTP retry policy.
API_TIMEOUT_MS=45000
API_RETRY_COUNT=1
API_RETRY_DELAY_MS=800

# Reminder behavior.
REMINDER_CHECK_INTERVAL_MS=60000
REMINDER_CONTEXT_TTL_MS=900000

# Proactive group context and user profile scope.
ACTIVELINK_GROUP_ID_1=
ACTIVELINK_GROUP_IDS=
PROACTIVE_CONTEXT_GROUPS=
PROACTIVE_CONTEXT_LIMIT=20
PROACTIVE_TRIGGER_MESSAGES=12
PROACTIVE_COOLDOWN_SECONDS=300
PROACTIVE_INITIAL_PROBABILITY=0.2
PROACTIVE_CHECK_INTERVAL_SECONDS=10
PROACTIVE_INITIAL_DELAY_SECONDS=1
ACTIVELINK_PRIVATE_ID_1=
ACTIVELINK_PRIVATE_ID_2=
ACTIVELINK_PRIVATE_IDS=

# Local RAG.
RAG_VECTOR_DIM=1024
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_QUERY_CACHE_TTL_MS=600000
RAG_MAX_CANDIDATES=3000
RAG_TERM_INDEX_MAX_TERMS_PER_TEXT=240

# Outgoing message splitting.
SPLIT_NATURAL_MIN_CHARS=34
SPLIT_NATURAL_MAX_CHARS=110
SPLIT_NATURAL_PART_MAX_CHARS=45
SPLIT_MERGE_MAX_CHARS=40
SPLIT_NATURAL_DELAY_MS=1200
SPLIT_LONG_DELAY_MS=2000

# Weather perception.
WEATHER_RETRY_MS=300000
WEATHER_REFRESH_MS=3600000
WEATHER_TIMEOUT_MS=8000
